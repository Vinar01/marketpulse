# ---- Database ----
DATABASE_URL=postgresql+asyncpg://marketpulse:marketpulse@localhost:5432/marketpulse
# Read-only role used exclusively by the AI tool layer (Guardrail Layer 4)
DATABASE_URL_RO=postgresql+asyncpg://marketpulse_ai_ro:marketpulse_ai_ro@localhost:5432/marketpulse
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=5000
DB_RO_STATEMENT_TIMEOUT_MS=3000

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_LATEST=2
CACHE_TTL_OHLCV=30

# ---- Ingestion ----
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
BINANCE_WS_URL=wss://stream.binance.com:9443/stream
BINANCE_REST_URL=https://api.binance.com
INGEST_QUEUE_MAXSIZE=20000
INGEST_BATCH_SIZE=500
INGEST_BATCH_INTERVAL_MS=250
AGGREGATOR_INTERVAL_S=20
PARTITION_AHEAD_DAYS=3
RETENTION_DAYS=30

# ---- API ----
API_KEYS=demo-key-public:public,demo-key-admin:admin
RATE_LIMIT_PER_MINUTE=120
MAX_PAGE_SIZE=1000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- AI layer ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_EFFORT=medium
AI_MAX_TOKENS=8000
AI_MAX_TOOL_ITERATIONS=6
AI_MAX_RANGE_DAYS=7
AI_MAX_ROWS=5000

# ---- Ops ----
LOG_LEVEL=INFO
ENV=development
